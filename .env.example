# Run `npm run demo` for an explicit, local-only demo. No provider keys needed.
APP_MODE=live
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Higgsfield API credentials. Keep both server-side.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_1000=
STRIPE_PRICE_CREATOR_MONTHLY=

# Explicit operator gates. Keep false until authorised and configured.
ENABLE_PAID_GENERATION=false
ENABLE_STRIPE_CHECKOUT=false
ALLOW_STRIPE_LIVE=false
ADMIN_USER_IDS=

# Exact comma-separated provider CDN hostnames. Extend only after verifying an observed Higgsfield output URL.
MEDIA_DOWNLOAD_HOSTS=storage.googleapis.com
MEDIA_DOWNLOAD_PATH_PREFIXES=/
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# For CI against a real disposable PostgreSQL instance only.
TEST_DATABASE_URL=
