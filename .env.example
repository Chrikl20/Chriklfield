# Run `npm run demo` for an explicit, local-only demo. No keys needed.
APP_MODE=live
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FAL_KEY=
FAL_WEBHOOK_USER_ID=
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_1000=
STRIPE_PRICE_CREATOR_MONTHLY=
# Explicit operator gates. Keep false until authorised and configured.
ENABLE_PAID_GENERATION=false
ENABLE_STRIPE_CHECKOUT=false
ALLOW_STRIPE_LIVE=false
ADMIN_USER_IDS=
# Exact comma-separated hostnames; signed URLs and redirect targets are checked.
MEDIA_DOWNLOAD_HOSTS=v3.fal.media,v3b.fal.media,v3c.fal.media,storage.googleapis.com
MEDIA_DOWNLOAD_PATH_PREFIXES=/files/,/falserverless/
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# For CI against a real disposable PostgreSQL instance only.
TEST_DATABASE_URL=

FAL_WEBHOOK_BINDING_SECRET=
